PORT=3000
# Leave blank for local use. On Render/Railway/VPS Docker, mount persistent storage at /data and set DATA_DIR=/data.
DATA_DIR=
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
# Optional: Google Gemini API for the AI Study Assistant. Keep this key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production deployments must set a unique ADMIN_PASSWORD (12+ characters) and
# a JWT_SECRET (32+ random characters). Never deploy with the sample credentials.

# Gmail notifications and password recovery (required for email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

